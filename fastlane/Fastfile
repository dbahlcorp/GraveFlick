require "base64"
require "fileutils"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Archive, sign, and upload GraveFlick to TestFlight"
  lane :beta do
    setup_ci

    required = %w[
      ASC_KEY_ID
      ASC_ISSUER_ID
      ASC_KEY_CONTENT
      APPLE_TEAM_ID
    ]
    missing = required.select { |name| ENV[name].to_s.empty? }
    UI.user_error!("Missing release environment: #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    key_path = File.expand_path("../asc_key.p8", __dir__)
    File.binwrite(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

    # Ask App Store Connect what the last uploaded build actually was, rather than trusting a
    # number hand-maintained across project.yml/ios.yml/README — that drifted before and will
    # again. `initial_build_number: 0` means a from-scratch app (no prior TestFlight build) still
    # produces build 1 instead of erroring.
    build_number = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.bahlcorp.graveflick",
      initial_build_number: 0
    ) + 1).to_s
    UI.message("Uploading as build #{build_number}")

    build_app(
      project: "GraveFlick.xcodeproj",
      scheme: "GraveFlick",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "GraveFlick.ipa",
      include_symbols: true,
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      },
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "-authenticationKeyPath #{key_path}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fastlane did not report an IPA output path") if ipa_path.to_s.empty?
    check_dir = File.join(File.dirname(ipa_path), "ipa-check")
    FileUtils.rm_rf(check_dir)
    FileUtils.mkdir_p(check_dir)
    sh("unzip -q #{Shellwords.escape(ipa_path)} -d #{Shellwords.escape(check_dir)}")
    app_path = File.join(check_dir, "Payload", "GraveFlick.app")
    UI.user_error!("Archive is missing compiled asset catalog") unless File.exist?(File.join(app_path, "Assets.car"))
    UI.user_error!("Archive is missing the 120x120 iPhone icon") unless Dir.glob(File.join(app_path, "AppIcon60x60@2x.png")).any?
    sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconName' '#{app_path}/Info.plist' | grep -qx AppIcon")

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.bahlcorp.graveflick",
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
  end
end
